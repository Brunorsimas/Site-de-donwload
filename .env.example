# Variáveis de Ambiente
NODE_ENV=production
PORT=3000

# Concorrência máxima de downloads simultâneos
MAX_CONCURRENT_JOBS=3

# Segurança — origens CORS permitidas (separadas por vírgula)
CORS_ORIGIN=https://seusite.com,https://www.seusite.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50

# Cache TTL (em segundos) para informações de vídeos
CACHE_TTL_SECONDS=3600
